                const cnpjs = text.match(REGEX.cnpj);
                if (cnpjs) cnpjs.forEach(c => {
                    const clean = c.replace(/\D/g, '');
                    if (clean.length === 14) {
                        // Rejeita CNPJs com todos os dígitos iguais (ex: 33333333333333)
                        if (/^(\d)\1{13}$/.test(clean)) return;
                        // Validação de dígitos verificadores
                        const w1 = [5,4,3,2,9,8,7,6,5,4,3,2];
                        let sum = 0;
                        for (let i = 0; i < 12; i++) sum += parseInt(clean[i]) * w1[i];
                        let r = sum % 11;
                        const d1 = r < 2 ? 0 : 11 - r;
                        if (parseInt(clean[12]) !== d1) return;
                        const w2 = [6,5,4,3,2,9,8,7,6,5,4,3,2];
                        sum = 0;
                        for (let i = 0; i < 13; i++) sum += parseInt(clean[i]) * w2[i];
                        r = sum % 11;
                        const d2 = r < 2 ? 0 : 11 - r;
                        if (parseInt(clean[13]) !== d2) return;
                        // Filtra VERSÁTIL
                        const raiz = clean.substring(0, 8);
                        const isVersatil = CNPJ_BLACKLIST.some(b => clean.includes(b) || raiz === b);
                        if (!isVersatil) extractedCnpjs.add(c);
                    }
                });

                // E-mails (filtra blacklist, VERSÁTIL, e malformados)
                const emails = text.match(REGEX.email);
                if (emails) emails.forEach(e => {
                    const lower = e.toLowerCase();
                    // Rejeita e-mails que começam com dígitos (ex: "3362-9779fernando.lemos@...")
                    if (/^\d/.test(lower)) return;
                    // Rejeita e-mails muito curtos (< 3 chars antes do @)
                    const localPart = lower.split('@')[0];
                    if (localPart.length < 3) return;
                    // Rejeita se contém sequências de dígitos longos (são números de doc, não emails)
                    if (/\d{6,}/.test(localPart)) return;
                    // Rejeita QUALQUER e-mail com "versatil" (pega todas variantes: versatilservices, versatilservises, versatilservice, versatilusinagem, etc.)
                    if (lower.includes('versatil')) return;
                    // Rejeita blacklist genérica
                    const isBlacklisted = EMAIL_BLACKLIST.some(b => lower.includes(b));
                    if (!isBlacklisted) {
                        extractedEmails.add(lower);
                    }
                });

                // Telefones (validação rigorosa com DDD brasileiro)
                const phones = text.match(REGEX.phone);
                if (phones) phones.forEach(p => {
                    const raw = p.trim();
                    // Rejeita números formatados com ponto (ex: 27.33614360 = número de documento)
                    if (/^\d{2}\.\d{8}$/.test(raw) || /^\d{2}\.\d{9}$/.test(raw)) return;
                    const clean = raw.replace(/\D/g, '');
                    // Remove prefixo +55 se presente
                    const semPais = clean.startsWith('55') && clean.length >= 12 ? clean.substring(2) : clean;
                    // Deve ter 10 (fixo) ou 11 (celular) dígitos
                    if (semPais.length < 10 || semPais.length > 11) return;
                    // Valida DDD (2 primeiros dígitos)
                    const ddd = semPais.substring(0, 2);
                    if (!DDDS_VALIDOS.has(ddd)) return;
                    // Celular deve começar com 9 após o DDD
                    if (semPais.length === 11 && semPais[2] !== '9') return;
                    // Telefone fixo: após DDD deve começar com 2-5 (não 0, 1, 6, 7, 8, 9)
                    if (semPais.length === 10) {
                        const prefixo = semPais[2];
                        if (!['2','3','4','5'].includes(prefixo)) return;
                    }
                    // Rejeita números com todos dígitos iguais (ex: 1111111111)
                    if (/^(\d)\1+$/.test(semPais)) return;
                    // Rejeita telefones da própria VERSÁTIL
                    const isVersatilPhone = PHONE_BLACKLIST.some(b => semPais.includes(b) || clean.includes(b));
                    if (isVersatilPhone) return;
                    extractedPhones.add(raw);
                });

                // CEPs
                const ceps = text.match(REGEX.cep);
                if (ceps) ceps.forEach(c => extractedCeps.add(c));

                // Valores BRL
                const valores = text.match(REGEX.valorBrl);
                if (valores) valores.forEach(v => {
                    const num = parseFloat(v.replace(/[R$\s.]/g, '').replace(',', '.'));
                    if (num > 100 && num < 100000000) extractedValores.add(v.trim());
                });

                // Datas
                const datas = text.match(REGEX.data);
                if (datas) datas.forEach(d => extractedDatas.add(d));

                // Websites
                const sites = text.match(REGEX.website);
                if (sites) sites.forEach(s => {
                    const lower = s.toLowerCase();
                    if (!lower.includes('versatilservices') && !lower.includes('google') && !lower.includes('facebook')) {
                        extractedSites.add(s.trim());
                    }
                });

                // Contatos (A/C, Att., Atenção)
                let contatoMatch;
                const contatoRegex = /(?:A\/C|Att?\.?|Aten[çc][aã]o|Prezado\(?a?\)?|Sr\.?|Sra\.?)[:\s]+([A-ZÀ-Ú][a-záéíóúãõê]+(?:\s+(?:de|da|do|dos|das)\s+)?(?:[A-ZÀ-Ú][a-záéíóúãõê]+)*)/g;
                while ((contatoMatch = contatoRegex.exec(text)) !== null) {
                    const nome = contatoMatch[1].trim();
                    if (nome.length > 3 && nome.length < 60 && !nome.match(/^(?:Prezado|Senhor|Empresa|Cliente|Departamento)$/i)) {
                        // Tenta achar cargo próximo
                        const surroundingText = text.substring(Math.max(0, contatoMatch.index - 50), contatoMatch.index + contatoMatch[0].length + 100);
                        const cargoMatch = surroundingText.match(REGEX.cargo);
                        extractedContatos.push({
                            nome: nome,
                            cargo: cargoMatch ? cargoMatch[0] : 'Não informado',
                            fonte: fileName
                        });
                    }
                }

                // Serviços industriais
                const textLower = text.toLowerCase();
                SERVICOS_KEYWORDS.forEach(kw => {
                    if (textLower.includes(kw)) {
                        // Captura contexto: pega a frase que contém o serviço
                        const idx = textLower.indexOf(kw);
                        const start = Math.max(0, textLower.lastIndexOf('\n', idx) + 1);
                        const end = Math.min(text.length, textLower.indexOf('\n', idx + kw.length));
                        const frase = text.substring(start, end > start ? end : start + 80).trim();
                        if (frase.length > 5 && frase.length < 200) {
                            extractedServicos.add(frase.replace(/[\r\n]+/g, ' ').trim());
                        }
                    }
                });
            }

            // Função recursiva para percorrer todas as pastas
            const traverseAsync = async (dir) => {
                let items;
                try { items = fs.readdirSync(dir); } catch(e) { return; }

                for (const item of items) {
                    const full = path.join(dir, item);
                    let stat;
                    try { stat = fs.statSync(full); } catch(e) { continue; }

                    if (stat.isDirectory()) {
                        inventario.subpastas++;
                        await traverseAsync(full);
                        continue;
                    }

                    inventario.total_arquivos++;
                    const ext = path.extname(item).toLowerCase();
                    const sizeKB = Math.round(stat.size / 1024);
                    const maxSizeMB = 15; // Limite de 15MB por arquivo

                    // Classificar no inventário
                    switch (ext) {
                        case '.pdf': inventario.pdf++; break;
                        case '.doc': inventario.doc++; break;
                        case '.docx': inventario.docx++; break;
                        case '.xls': inventario.xls++; break;
                        case '.xlsx': inventario.xlsx++; break;
                        case '.txt': inventario.txt++; break;
                        case '.csv': inventario.csv++; break;
                        case '.msg': inventario.msg++; break;
                        case '.eml': inventario.eml++; break;
                        case '.jpg': case '.jpeg': inventario.jpg++; break;
                        case '.png': inventario.png++; break;
                        default: inventario.outros++; break;
                    }

                    // Pular arquivos muito grandes
                    if (stat.size > maxSizeMB * 1024 * 1024) {
                        inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'ignorado_tamanho' });
                        continue;
                    }

                    // Ler e extrair de cada tipo de arquivo
                    try {
                        let text = '';

                        // === PDF ===
                        if (ext === '.pdf') {
                            const buffer = fs.readFileSync(full);
                            const data = await pdfParse(buffer);
                            text = data.text || '';
                        }
                        // === DOCX ===
                        else if (ext === '.docx') {
                            const result = await mammoth.extractRawText({ path: full });
                            text = result.value || '';
                        }
                        // === DOC (Word 97 — tentativa com mammoth, pode falhar) ===
                        else if (ext === '.doc') {
                            try {
                                const result = await mammoth.extractRawText({ path: full });
                                text = result.value || '';
                            } catch(docErr) {
                                // .doc antigo — mammoth não suporta. Registra para Fase 2.
                                inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'formato_legado_doc97' });
                                inventario.arquivos_com_erro++;
                                continue;
                            }
                        }
                        // === XLSX / XLS ===
                        else if (ext === '.xlsx' || ext === '.xls') {
                            const workbook = XLSX.readFile(full);
                            const allText = [];
                            workbook.SheetNames.forEach(sheetName => {
                                const sheet = workbook.Sheets[sheetName];
                                const json = XLSX.utils.sheet_to_json(sheet, { header: 1, defval: '' });
                                json.forEach(row => {
                                    if (Array.isArray(row)) {
                                        allText.push(row.map(cell => String(cell)).join(' | '));
                                    }
                                });
                            });
                            text = allText.join('\n');
                        }
                        // === CSV ===
                        else if (ext === '.csv') {
                            const raw = fs.readFileSync(full, 'utf8');
                            try {
                                const records = csvParseSync(raw, { skip_empty_lines: true, relax_column_count: true });
                                text = records.map(r => r.join(' | ')).join('\n');
                            } catch(csvErr) {
                                text = raw; // Fallback: usar o texto bruto
                            }
                        }
                        // === TXT / EML ===
                        else if (ext === '.txt' || ext === '.eml') {
                            text = fs.readFileSync(full, 'utf8');
                        }
                        // === MSG (binário Outlook — extração parcial) ===
                        else if (ext === '.msg') {
                            try {
                                const buffer = fs.readFileSync(full);
                                // MSG é binário OLE. Extraímos strings legíveis do buffer.
                                // Procura por sequências ASCII/UTF-16LE legíveis
                                const asciiText = buffer.toString('ascii').replace(/[^\x20-\x7E\r\n]/g, ' ');
                                const utf16Text = [];
                                for (let i = 0; i < buffer.length - 1; i += 2) {
                                    const charCode = buffer[i] | (buffer[i+1] << 8);
                                    if (charCode >= 32 && charCode < 127) {
                                        utf16Text.push(String.fromCharCode(charCode));
                                    } else if (charCode === 13 || charCode === 10) {
                                        utf16Text.push('\n');
                                    } else {
                                        utf16Text.push(' ');
                                    }
                                }
                                text = asciiText + '\n' + utf16Text.join('');
                            } catch(msgErr) {
                                inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'erro_msg' });
                                inventario.arquivos_com_erro++;
                                continue;
                            }
                        }
                        // === Imagens: apenas inventariar (OCR = Fase 3) ===
                        else if (['.jpg', '.jpeg', '.png', '.bmp', '.tiff', '.gif'].includes(ext)) {
                            inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'inventariado_sem_ocr' });
                            continue;
                        }
                        // === Outros: ignorar ===
                        else {
                            inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'tipo_nao_suportado' });
                            continue;
                        }

                        // Se extraiu texto, processar com regex
                        if (text && text.trim().length > 10) {
                            extractFromText(text, item);
                            inventario.arquivos_lidos++;
                            fontesUtilizadas.push(`${item} (${ext.replace('.','').toUpperCase()}, ${sizeKB}KB)`);
                        } else {
                            inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'sem_texto_extraido' });
                        }

                    } catch (fileErr) {
                        inventario.arquivos_com_erro++;
                        errosLeitura.push({ arquivo: item, erro: fileErr.message });
                        inventario.arquivos_detalhes.push({ nome: item, tipo: ext, tamanho_kb: sizeKB, status: 'erro_leitura', erro: fileErr.message });
                    }
                }
            };

            await traverseAsync(folderPath);
        }

        // ============================================================
        // ETAPA 4: CONSOLIDAR EXTRAÇÃO LOCAL
        // ============================================================
        const localCnpjs = [...extractedCnpjs];
        const localEmails = [...extractedEmails].slice(0, 20);
        const localPhones = [...extractedPhones].slice(0, 20);
        const localValores = [...extractedValores].slice(0, 15);
        const localDatas = [...extractedDatas].slice(0, 15);
        const localCeps = [...extractedCeps].slice(0, 5);
        const localSites = [...extractedSites].slice(0, 5);
        const localServicos = [...extractedServicos].slice(0, 20);

        // Deduplicar contatos por nome
        const contatosUnicos = [];
        const nomesVistos = new Set();
        extractedContatos.forEach(c => {
            const key = c.nome.toLowerCase();
            if (!nomesVistos.has(key)) {
                nomesVistos.add(key);
                contatosUnicos.push(c);
            }
        });

        // ============================================================
        // ETAPA 5: MOTOR DE INTELIGÊNCIA EMPRESARIAL v2.0
        // ============================================================
        let possibleCnpj = localCnpjs.length > 0
            ? localCnpjs.find(c => c.includes('/0001')) || localCnpjs[0]
            : (client.cnpj || null);

        let cnpjFonte = null;
        let cnpjSimilaridade = 0;
        let cnpjValidado = false;

        if (possibleCnpj) {
            cnpjFonte = 'Documento Local';
            cnpjSimilaridade = 95;
            cnpjValidado = true;
            fontes.cnpj = { fonte: 'Documento Local', confianca: 95 };
        }

        let possibleSite = localSites.length > 0 ? [...localSites][0] : null;
        if (possibleSite) fontes.site = { fonte: 'Documento Local', confianca: 90 };

        // ============================================================
        // ETAPA 5.0: DESCOBERTA DIRETA DE CNPJ POR NOME (ALTA PRIORIDADE)
        // ============================================================
        // Busca em diretórios de CNPJ (que indexam a base da RF por nome)
        // MUITO mais eficaz que DDG genérico para descoberta de CNPJ
        // ============================================================
        const DDG_HEADERS = { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36' };

        async function fetchWithTimeout(url, opts = {}, timeoutMs = 8000) {
            return fetch(url, { ...opts, signal: AbortSignal.timeout(timeoutMs) });
        }

        if (!possibleCnpj) {
            const nomeBusca = client.nome_cliente.trim();
            const nomeSemAcento = nomeBusca.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            let cnpjCandidatos = []; // { cnpj, fonte, similaridade, razao }

            // ── FONTE 1: Busca direta em cnpj.biz (diretório RF por nome) ──
            const tCnpjBiz = Date.now();
            try {
                const qBiz = encodeURIComponent(nomeSemAcento);
                const rBiz = await fetchWithTimeout(`https://search.yahoo.com/search?p=site:cnpj.biz+"${qBiz}"`, { headers: DDG_HEADERS });
                const htmlBiz = await rBiz.text();
                const cnpjsBiz = htmlBiz.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
                const filteredBiz = cnpjsBiz.filter(c => { const cl = c.replace(/\D/g, ''); return !CNPJ_BLACKLIST.some(b => cl.includes(b) || cl.substring(0,8) === b); });
                filteredBiz.forEach(c => cnpjCandidatos.push({ cnpj: c, fonte: 'cnpj.biz' }));
                logEtapa('CNPJ por Nome', 'cnpj.biz', filteredBiz.length > 0 ? '✅' : '❌', filteredBiz.length, tCnpjBiz);
            } catch(e) { logEtapa('CNPJ por Nome', 'cnpj.biz', '❌ ' + e.message, 0, tCnpjBiz); }

            // ── FONTE 2: CasaDosDados (busca empresa por nome via DDG) ──
            const tCasa = Date.now();
            try {
                const qCasa = encodeURIComponent(`"${nomeSemAcento}" CNPJ site:casadosdados.com.br`);
                const rCasa = await fetchWithTimeout(`https://search.yahoo.com/search?p=${qCasa}`, { headers: DDG_HEADERS });
                const htmlCasa = await rCasa.text();
                const cnpjsCasa = htmlCasa.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
                const filteredCasa = cnpjsCasa.filter(c => { const cl = c.replace(/\D/g, ''); return !CNPJ_BLACKLIST.some(b => cl.includes(b) || cl.substring(0,8) === b); });
                filteredCasa.forEach(c => cnpjCandidatos.push({ cnpj: c, fonte: 'CasaDosDados' }));
                logEtapa('CNPJ por Nome', 'CasaDosDados', filteredCasa.length > 0 ? '✅' : '❌', filteredCasa.length, tCasa);
            } catch(e) { logEtapa('CNPJ por Nome', 'CasaDosDados', '❌ ' + e.message, 0, tCasa); }

            // ── FONTE 3: Speedio/EconoData (busca empresa por nome via DDG) ──
            const tSpeedio = Date.now();
            try {
                const qSp = encodeURIComponent(`"${nomeSemAcento}" CNPJ site:speedio.com.br OR site:econodata.com.br`);
                const rSp = await fetchWithTimeout(`https://search.yahoo.com/search?p=${qSp}`, { headers: DDG_HEADERS });
                const htmlSp = await rSp.text();
                const cnpjsSp = htmlSp.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
                const filteredSp = cnpjsSp.filter(c => { const cl = c.replace(/\D/g, ''); return !CNPJ_BLACKLIST.some(b => cl.includes(b) || cl.substring(0,8) === b); });
                filteredSp.forEach(c => cnpjCandidatos.push({ cnpj: c, fonte: 'Speedio/EconoData' }));
                logEtapa('CNPJ por Nome', 'Speedio', filteredSp.length > 0 ? '✅' : '❌', filteredSp.length, tSpeedio);
            } catch(e) { logEtapa('CNPJ por Nome', 'Speedio', '❌ ' + e.message, 0, tSpeedio); }

            // ── FONTE 4: InfoPlex/CNPJ.ws (via DDG) ──
            const tInfo = Date.now();
            try {
                const qInfo = encodeURIComponent(`"${nomeSemAcento}" CNPJ site:cnpj.ws OR site:infoplex.com.br`);
                const rInfo = await fetchWithTimeout(`https://search.yahoo.com/search?p=${qInfo}`, { headers: DDG_HEADERS });
                const htmlInfo = await rInfo.text();
                const cnpjsInfo = htmlInfo.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
                const filteredInfo = cnpjsInfo.filter(c => { const cl = c.replace(/\D/g, ''); return !CNPJ_BLACKLIST.some(b => cl.includes(b) || cl.substring(0,8) === b); });
                filteredInfo.forEach(c => cnpjCandidatos.push({ cnpj: c, fonte: 'CNPJ.ws' }));
                logEtapa('CNPJ por Nome', 'CNPJ.ws', filteredInfo.length > 0 ? '✅' : '❌', filteredInfo.length, tInfo);
            } catch(e) { logEtapa('CNPJ por Nome', 'CNPJ.ws', '❌ ' + e.message, 0, tInfo); }

            // ── CONSOLIDAÇÃO DE CANDIDATOS ──
            if (cnpjCandidatos.length > 0) {
                // Contar frequência de cada CNPJ entre TODAS as fontes
                const freq = {};
                const fontesPorCnpj = {};
                cnpjCandidatos.forEach(c => {
                    const k = c.cnpj.replace(/\D/g, '');
                    freq[k] = (freq[k] || 0) + 1;
                    if (!fontesPorCnpj[k]) fontesPorCnpj[k] = new Set();
                    fontesPorCnpj[k].add(c.fonte);
                });

                // Ordenar: mais fontes distintas > mais citações > priorizar matriz
                const sorted = Object.entries(freq).sort((a, b) => {
                    const aFontes = fontesPorCnpj[a[0]].size;
                    const bFontes = fontesPorCnpj[b[0]].size;
                    if (aFontes !== bFontes) return bFontes - aFontes;
                    const aMatriz = a[0].substring(8, 12) === '0001' ? 1 : 0;
                    const bMatriz = b[0].substring(8, 12) === '0001' ? 1 : 0;
                    if (aMatriz !== bMatriz) return bMatriz - aMatriz;
                    return b[1] - a[1];
                });

                const bestCnpjRaw = sorted[0][0];
                const bestFontes = [...fontesPorCnpj[bestCnpjRaw]].join(', ');
                const bestFreq = sorted[0][1];

                // Validar na BrasilAPI ANTES de aceitar
                const tValidDir = Date.now();
                try {
                    const rVal = await fetchWithTimeout(`https://brasilapi.com.br/api/cnpj/v1/${bestCnpjRaw}`, { headers: DDG_HEADERS }, 6000);
                    if (rVal.ok) {
                        const dVal = await rVal.json();
                        if (!dVal.message && dVal.razao_social) {
                            const sim1 = calcSimilarity(client.nome_cliente, dVal.razao_social);
                            const sim2 = dVal.nome_fantasia ? calcSimilarity(client.nome_cliente, dVal.nome_fantasia) : 0;
                            const simMax = Math.max(sim1, sim2);
                            if (simMax >= 35) {
                                possibleCnpj = bestCnpjRaw.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
                                cnpjFonte = `Diretório RF (${bestFontes}) — ${bestFreq}x citado, ${sorted.length} CNPJs`;
                                cnpjSimilaridade = simMax;
                                cnpjValidado = simMax >= 60;
                                fontes.cnpj = { fonte: cnpjFonte, confianca: simMax, razao_rf: dVal.razao_social };
                                console.log(`[V-Bot] ✅ CNPJ DESCOBERTO via diretório: ${possibleCnpj} — ${dVal.razao_social} (${simMax}% similar, fontes: ${bestFontes})`);
                                logEtapa('Validação Diretório', 'BrasilAPI', '✅ ' + simMax + '%', simMax, tValidDir);
                            } else {
                                console.log(`[V-Bot] ❌ CNPJ descartado: ${dVal.razao_social} (${simMax}% — mínimo 35%)`);
                                logEtapa('Validação Diretório', 'BrasilAPI', '❌ Baixa sim: ' + simMax + '%', 0, tValidDir);
                            }
                        }
                    }
                } catch(e) { logEtapa('Validação Diretório', 'BrasilAPI', '❌ ' + e.message, 0, tValidDir); }
            }

            console.log(`[V-Bot] Após diretórios: CNPJ=${possibleCnpj || 'NÃO ENCONTRADO'} (${cnpjCandidatos.length} candidatos de 4 fontes)`);
        }

        // ============================================================
        // ETAPA 5.0b: CONECTORES API PREMIUM (desativados - aguardando chaves)
        // ============================================================

        // ── GOOGLE PLACES API (DESATIVADO — necessita GOOGLE_PLACES_KEY) ──
        const GOOGLE_PLACES_KEY = process.env.GOOGLE_PLACES_KEY || null;
        let googlePlacesData = null;
        if (GOOGLE_PLACES_KEY && !possibleCnpj) {
            const tGP = Date.now();
            try {
                const gpQuery = encodeURIComponent(client.nome_cliente + (client.cidade ? ' ' + client.cidade : ''));
