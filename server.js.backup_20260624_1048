            if (sit.includes('ATIVA')) statusEmpresa = 'ativa';
            else if (sit.includes('BAIXA') || sit.includes('ENCERR')) statusEmpresa = 'encerrada';
            else if (sit.includes('SUSP') || sit.includes('INAP')) statusEmpresa = 'suspensa';
            else statusEmpresa = 'irregular';
        }

        // ============================================================
        // ETAPA 7c: OPPORTUNITY SCORE (Inteligência Comercial Versátil)
        // ============================================================
        const CNAE_SERVICOS = {
            'MINERAÇÃO': { servicos: ['Usinagem de Campo','Mandrilhamento','Recuperação de Eixos','Retífica de Pistas','Soldagem Especial'], peso: 35 },
