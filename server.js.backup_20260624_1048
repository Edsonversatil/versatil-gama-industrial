                    const html5 = await buscaDDG(`"${telLimpo.replace(/(\d{2})(\d{4,5})(\d{4})/, '($1) $2-$3')}" empresa CNPJ`, 'Busca por Telefone');
                    todosWebCnpjs.push(...extrairCNPJs(html5));
