// POST /api/crm/vbot/aprovar/:id — Aprovar dados do V-Bot Hunter e salvar na Ficha Comercial
app.post('/api/crm/vbot/aprovar/:id', (req, res) => {
    try {
        const clientesPath = path.join(parentDir, 'clientes_database.json');
        let dbClientes = JSON.parse(fs.readFileSync(clientesPath, 'utf8'));
        const idx = dbClientes.findIndex(c => c.id_cliente === req.params.id);
        if (idx === -1) return res.status(404).json({ error: 'Cliente não encontrado.' });

        const dados = req.body;
        const cliente = dbClientes[idx];

        // ============================================================
        // NORMALIZAÇÃO DE PORTE
        // ============================================================
        if (dados.porte_empresa) {
            const p = dados.porte_empresa.toUpperCase();
            if (p.includes('DEMAIS') || p.includes('GRANDE')) dados.porte_empresa = 'Grande';
            else if (p.includes('MÉDIO') || p.includes('MEDIO')) dados.porte_empresa = 'Médio';
            else if (p.includes('PEQUENO') || p === 'EPP') dados.porte_empresa = 'Pequeno';
            else if (p.includes('MICRO') || p === 'MEI' || p === 'ME') dados.porte_empresa = 'Micro';
        }

        // ============================================================
        // MERGE INTELIGENTE — Não sobrescreve dados manuais existentes
        // ============================================================
        const camposBaixoRisco = [
            'website', 'cnpj', 'cidade', 'estado', 'porte_empresa',
            'segmento_industrial', 'contato_fixo'
        ];

        const camposSempreSobrescreve = [
            'nome_cliente', 'contato_nome', 'contato_cargo',
            'contato_email', 'contato_telefone', 'email_departamento'
        ];

        // Campos de baixo risco: só preenche se vazio
        camposBaixoRisco.forEach(key => {
            if (dados[key] && (!cliente[key] || cliente[key] === 'Não informado' || cliente[key] === '')) {
                cliente[key] = dados[key];
            }
        });

        // Campos que o humano acabou de revisar: sempre atualiza
        camposSempreSobrescreve.forEach(key => {
            if (dados[key] !== undefined && dados[key] !== '') {
                cliente[key] = dados[key];
            }
        });

        // ============================================================
        // EMAILS ADICIONAIS — Merge (adiciona, não substitui)
        // ============================================================
        if (dados.emails_adicionais && Array.isArray(dados.emails_adicionais)) {
            if (!cliente.emails_adicionais) cliente.emails_adicionais = [];
            
            const existentes = new Set(cliente.emails_adicionais.map(e => e.email.toLowerCase()));
            dados.emails_adicionais.forEach(ea => {
                if (ea.email && !existentes.has(ea.email.toLowerCase())) {
                    cliente.emails_adicionais.push(ea);
                    existentes.add(ea.email.toLowerCase());
                }
            });
        }

        // ============================================================
        // METADADOS DE VERIFICAÇÃO
        // ============================================================
        cliente.status_verificacao = 'verificado';
        cliente.data_verificacao = new Date().toISOString();
        cliente.verificado_por = dados.verificado_por || 'admin';
        cliente.fonte_verificacao = 'vbot_hunter';
        cliente.habilitado_campanha = dados.habilitado_campanha !== false; // true por padrão
        
        if (dados.vbot_cobertura) cliente.vbot_cobertura = dados.vbot_cobertura;
        if (dados.vbot_arquivos_lidos) cliente.vbot_arquivos_lidos = dados.vbot_arquivos_lidos;

        // ============================================================
        // SALVAR
        // ============================================================
        dbClientes[idx] = cliente;
        fs.writeFileSync(clientesPath, JSON.stringify(dbClientes, null, 2), 'utf8');

        console.log(`[V-Bot Aprovar] ✅ Cliente ${req.params.id} (${cliente.nome_cliente}) aprovado por ${cliente.verificado_por} | Cobertura: ${cliente.vbot_cobertura || 'N/A'}%`);

        res.json({ 
            success: true, 
            message: `Cliente ${cliente.nome_cliente} aprovado e salvo na Ficha Comercial.`,
            client: cliente
        });
    } catch (err) {
        console.error(`[V-Bot Aprovar] Erro:`, err.message);
        res.status(500).json({ error: err.message });
    }
});


