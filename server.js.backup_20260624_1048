            }

            // ── CONSOLIDAR SITE: selecionar o mais provável ──
            if (!possibleSite && todosWebSites.length > 0) {
                // Score de relevância: domínio que contém parte do nome da empresa ganha prioridade
                const nomeSimples = client.nome_cliente.toLowerCase().replace(/[^a-z0-9]/g, '');
