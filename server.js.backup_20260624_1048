        // ── 5.1: NORMALIZAÇÃO + GERAÇÃO DE VARIAÇÕES ──
        function gerarVariacoes(nome) {
            const base = nome.trim();
            const semAcento = base.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const variantes = new Set([base]);
            variantes.add(semAcento);
            // Remover sufixos comuns
            const sufixos = [' LTDA', ' S/A', ' S.A.', ' SA', ' ME', ' EPP', ' EIRELI', ' LLC', ' INC', ' FZCO', ' SL'];
            for (const s of sufixos) {
                if (base.toUpperCase().endsWith(s)) {
                    variantes.add(base.substring(0, base.length - s.length).trim());
                }
                variantes.add(base + s);
            }
            // Variações com Grupo
            if (!base.toUpperCase().startsWith('GRUPO ')) variantes.add('Grupo ' + base);
            return [...variantes].slice(0, 6); // Max 6 variações
        }
        const variacoesNome = gerarVariacoes(client.nome_cliente);
