            const html2 = await buscaDDG(`"${nomePrincipal}" telefone contato site`, 'Busca Contato');
            todosWebCnpjs.push(...extrairCNPJs(html2));
            todosWebSites.push(...extrairSites(html2));

            // Query 3: Variação do nome + CNPJ (se o nome principal não achou)
