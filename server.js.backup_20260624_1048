            'CONSTRUÇÃO': { servicos: ['Caldeiraria','Soldagem Especial','Manutenção Industrial'], peso: 20 },
            'ENGENHARIA': { servicos: ['Usinagem de Campo','Mandrilhamento','Manutenção Industrial','Caldeiraria'], peso: 25 },
            'ALIMENT': { servicos: ['Trocadores de Calor','Manutenção Industrial','Caldeiraria'], peso: 20 },
