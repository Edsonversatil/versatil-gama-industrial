            if (todosWebCnpjs.length === 0 && emailCliente) {
                const dominio = emailCliente.split('@')[1];
                if (dominio && !['gmail.com','hotmail.com','outlook.com','yahoo.com'].includes(dominio.toLowerCase())) {
