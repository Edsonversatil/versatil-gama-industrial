            'AUTOMÓV': { servicos: ['Usinagem de Campo','Retífica de Pistas'], peso: 15 },
            'SANEAMENTO': { servicos: ['Caldeiraria','Manutenção Industrial'], peso: 15 }
        };

        let opportunityScore = 0;
        let servicosProvaveis = [];
        let opportunityRazao = [];

        // 1. Segmento (até 35 pontos)
        const segmentoAtual = client.segmento_industrial || '';
        const atividadeRF = receitaData ? (receitaData.atividade || '').toUpperCase() : '';
        const textoAnalise = (segmentoAtual + ' ' + atividadeRF).toUpperCase();
        for (const [key, val] of Object.entries(CNAE_SERVICOS)) {
            if (textoAnalise.includes(key.toUpperCase())) {
                opportunityScore += val.peso;
                servicosProvaveis = [...new Set([...servicosProvaveis, ...val.servicos])];
                opportunityRazao.push(`Segmento ${key}: +${val.peso}%`);
                break;
            }
        }

        // 2. Porte (até 20 pontos)
        if (receitaData && receitaData.porte) {
            const p = receitaData.porte.toUpperCase();
            if (p.includes('DEMAIS') || p.includes('GRANDE')) { opportunityScore += 20; opportunityRazao.push('Porte Grande: +20%'); }
            else if (p.includes('MÉDIO') || p.includes('MEDIO')) { opportunityScore += 15; opportunityRazao.push('Porte Médio: +15%'); }
            else if (p.includes('PEQUENO')) { opportunityScore += 5; opportunityRazao.push('Porte Pequeno: +5%'); }
        }

        // 3. Localização (até 15 pontos)
        const ufCliente = receitaData ? receitaData.uf : (client.estado || '');
        const ufsAcessiveis = ['ES','RJ','SP','MG','BA','PR','SC','RS','PE','CE'];
        if (ufsAcessiveis.includes(ufCliente.toUpperCase())) { opportunityScore += 15; opportunityRazao.push(`Localização ${ufCliente}: +15%`); }
        else if (ufCliente) { opportunityScore += 5; opportunityRazao.push(`Localização ${ufCliente}: +5%`); }

        // 4. Situação Ativa (até 10 pontos)
        if (statusEmpresa === 'ativa') { opportunityScore += 10; opportunityRazao.push('Situação Ativa: +10%'); }

        // 5. Possui manutenção/engenharia (até 10 pontos)
        const textoCompleto = (atividadeRF + ' ' + segmentoAtual + ' ' + (receitaData?.cnaes_secundarios?.map(c => c.descricao).join(' ') || '')).toUpperCase();
        if (textoCompleto.includes('MANUTENÇÃO') || textoCompleto.includes('MANUTENCAO') || textoCompleto.includes('ENGENHARIA') || textoCompleto.includes('INDUSTRIAL')) {
            opportunityScore += 10; opportunityRazao.push('Área de manutenção/engenharia: +10%');
        }

        // Cap at 100
        opportunityScore = Math.min(opportunityScore, 100);
        let opportunityClassificacao = 'Baixo';
        if (opportunityScore >= 80) opportunityClassificacao = 'Muito Alto';
        else if (opportunityScore >= 60) opportunityClassificacao = 'Alto';
        else if (opportunityScore >= 40) opportunityClassificacao = 'Médio';

        // ============================================================
