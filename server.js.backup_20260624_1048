            const rNews = await fetchWithTimeout(`https://search.yahoo.com/search?p=${queryNews}`, {
                headers: { 'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64)' }
            });
            const htmlNews = await rNews.text();
            // Extrair títulos dos resultados (class="result__a")
            const titleMatches = htmlNews.match(/class="result__a"[^>]*>([^<]+)</gi) || [];
            titleMatches.slice(0, 3).forEach(m => {
                const title = m.replace(/class="result__a"[^>]*>/i, '').trim();
                if (title.length > 10 && !title.toLowerCase().includes('linkedin') && !title.toLowerCase().includes('facebook')) {
                    noticias.push(title);
