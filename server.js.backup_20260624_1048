        function extrairCNPJs(html) {
            const allCnpjs = html.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
            return allCnpjs.filter(c => {
                const clean = c.replace(/\D/g, '');
                const raiz = clean.substring(0, 8);
                return !CNPJ_BLACKLIST.some(b => clean.includes(b) || raiz === b);
            });
        }

        function extrairSites(html) {
