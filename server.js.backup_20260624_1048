        // Detecta se nome mudou e calcula similaridade RF
        let nomeAlterado = false;
        let similaridadeNome = 0;
        if (receitaData && receitaData.razao_social) {
            const nomeDb = client.nome_cliente.toUpperCase().trim();
            const nomeRf = receitaData.razao_social.toUpperCase().trim();
            similaridadeNome = calcSimilarity(nomeDb, nomeRf);
            if (receitaData.nome_fantasia) {
                similaridadeNome = Math.max(similaridadeNome, calcSimilarity(nomeDb, receitaData.nome_fantasia.toUpperCase()));
            }
            nomeAlterado = similaridadeNome < 50;
            fontes.razao_social = { fonte: cnpjFonte ? cnpjFonte + ' → Receita Federal' : 'Receita Federal', confianca: similaridadeNome };
        }

        // ============================================================
        // ETAPA 6b: DETECÇÃO MATRIZ / FILIAIS
        // ============================================================
        let matrizFilial = { tipo: null, cnpj_matriz: null, filiais: [] };
        if (possibleCnpj) {
            const cnpjLimpo = possibleCnpj.replace(/\D/g, '');
            const raizCnpj = cnpjLimpo.substring(0, 8);
            const ordemCnpj = cnpjLimpo.substring(8, 12);
            matrizFilial.tipo = ordemCnpj === '0001' ? 'MATRIZ' : 'FILIAL';
            
            // Se é filial, calcular CNPJ da matriz
            if (matrizFilial.tipo === 'FILIAL') {
                const matrizDigits = raizCnpj + '0001';
                const calcCheckDigits = (cnpj12) => {
                    const w1 = [5,4,3,2,9,8,7,6,5,4,3,2];
                    let sum = 0;
                    for (let i = 0; i < 12; i++) sum += parseInt(cnpj12[i]) * w1[i];
                    let r = sum % 11;
                    const d1 = r < 2 ? 0 : 11 - r;
                    const cnpj13 = cnpj12 + d1;
                    const w2 = [6,5,4,3,2,9,8,7,6,5,4,3,2];
                    sum = 0;
                    for (let i = 0; i < 13; i++) sum += parseInt(cnpj13[i]) * w2[i];
                    r = sum % 11;
                    const d2 = r < 2 ? 0 : 11 - r;
                    return `${d1}${d2}`;
                };
                const check = calcCheckDigits(matrizDigits);
                const matrizFull = matrizDigits + check;
                matrizFilial.cnpj_matriz = matrizFull.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
                console.log(`[V-Bot] CNPJ é FILIAL — Matriz calculada: ${matrizFilial.cnpj_matriz}`);
            }

            // Buscar filiais via DuckDuckGo + diretórios (se é matriz)
            if (matrizFilial.tipo === 'MATRIZ' && receitaData && receitaData.razao_social) {
                const tFiliais = Date.now();
                try {
                    const qFiliais = encodeURIComponent(`"${raizCnpj}" CNPJ site:cnpj.biz`);
                    const rFiliais = await fetchWithTimeout(`https://search.yahoo.com/search?p=${qFiliais}`, { headers: DDG_HEADERS });
                    const htmlFiliais = await rFiliais.text();
                    const todosFiliais = htmlFiliais.match(/\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2}/g) || [];
                    const filiaisUnicas = [...new Set(todosFiliais)].filter(c => {
                        const cl = c.replace(/\D/g, '');
                        return cl.substring(0, 8) === raizCnpj && cl !== cnpjLimpo;
                    });
                    matrizFilial.filiais = filiaisUnicas.map(f => ({ cnpj: f, tipo: f.includes('/0001-') ? 'MATRIZ' : 'FILIAL' }));
