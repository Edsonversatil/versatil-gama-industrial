            // ── CONSOLIDAR CNPJ: selecionar o melhor por frequência ──
            if (todosWebCnpjs.length > 0) {
                // Contar frequência de cada CNPJ
                const freq = {};
                todosWebCnpjs.forEach(c => { const k = c.replace(/\D/g, ''); freq[k] = (freq[k] || 0) + 1; });
                // Ordenar por frequência (mais citado primeiro), priorizar matriz (/0001-)
                const sorted = Object.entries(freq).sort((a, b) => {
                    const aMatriz = a[0].substring(8, 12) === '0001' ? 1 : 0;
                    const bMatriz = b[0].substring(8, 12) === '0001' ? 1 : 0;
                    if (aMatriz !== bMatriz) return bMatriz - aMatriz;
                    return b[1] - a[1];
                });
                const bestCnpj = sorted[0][0];
                possibleCnpj = bestCnpj.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, '$1.$2.$3/$4-$5');
                cnpjFonte = `DuckDuckGo (${sorted[0][1]}x em ${Object.keys(freq).length} CNPJs)`;
                console.log(`[V-Bot] CNPJ consolidado: ${possibleCnpj} — citado ${sorted[0][1]}x`);
            }

            // Se encontrou CNPJ via web → validar na RF
            if (possibleCnpj && cnpjFonte) {
