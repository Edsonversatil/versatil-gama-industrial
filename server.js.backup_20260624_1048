            console.log(`==================================================`);
            console.log(`- Domínio Encontrado: ${siteBase}`);
            console.log(`- Páginas Raspadas: ${pagesToTry.length}`);
            console.log(`- Quantidade de HTML analisado: ${siteScrapeData.totalBytes || 0} bytes`);
